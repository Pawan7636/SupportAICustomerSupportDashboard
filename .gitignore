# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
server/dist/

# ── Environment & secrets (NEVER commit these) ───────────────────────────────
.env
.env.local
.env.*.local
server/.env
server/.env.local
# Keep .env.example files — they are safe templates

# ── Database ──────────────────────────────────────────────────────────────────
server/data/
*.db
*.db-shm
*.db-wal

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
*-debug.log*
npm-debug.log*
pnpm-debug.log*

# ── Cache & temp ──────────────────────────────────────────────────────────────
.cache/
.vite/
vite.config.*.timestamp-*
*.tsbuildinfo
.tmp-*

# ── Lock files — keep pnpm-lock.yaml (frontend), ignore npm package-lock at root
package-lock.json

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
*.swp
*.swo

# ── Figma Make platform files ─────────────────────────────────────────────────
/.figma/design-context/
/.plugins/
/.opencode-skills/
.claude-replay.*
