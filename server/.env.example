# ─────────────────────────────────────────────────────────────────────────────
#  SupportAI Backend — Environment variables
#  Copy this file to server/.env and fill in the values.
#  Never commit server/.env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS — comma-separated list of allowed frontend origins ──────────────────
# CORS_ORIGINS=https://your-production-domain.com

# ── Database ─────────────────────────────────────────────────────────────────
# Default: ./data/support.db (relative to the server/ directory)
# DB_PATH=./data/support.db

# ── JWT secrets — generate strong random values for production ───────────────
# Example (Node.js): require('crypto').randomBytes(64).toString('hex')
JWT_ACCESS_SECRET=CHANGE_ME_use_a_long_random_string
JWT_REFRESH_SECRET=CHANGE_ME_use_a_different_long_random_string

# Token lifetimes (optional — defaults shown)
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Get a free API key at: https://aistudio.google.com/app/apikey
# Used for:
#   - Chat responses (gemini-2.0-flash)
#   - Knowledge base embeddings (text-embedding-004)
GEMINI_API_KEY=CHANGE_ME

# Override the generative model (optional — default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ── bcrypt cost factor (optional — default: 12) ───────────────────────────────
# BCRYPT_ROUNDS=12
